{
  "type": "module",
  "name": "@oh-my-pi/collab-web",
  "version": "16.3.6",
  "private": true,
  "description": "Build-time tool renderers for standalone Agent Runtime HTML exports",
  "homepage": "https://omp.sh",
  "author": "Stencil Labs, Inc.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/can1357/oh-my-pi.git",
    "directory": "packages/collab-web"
  },
  "bugs": {
    "url": "https://github.com/can1357/oh-my-pi/issues"
  },
  "keywords": [
    "export",
    "html",
    "react",
    "agent"
  ],
  "scripts": {
    "gen:tool-views": "bun scripts/build-tool-views.ts",
    "test": "bun test --parallel",
    "check": "biome check . && bun run check:types",
    "check:types": "tsgo -p tsconfig.json --noEmit",
    "lint": "biome lint .",
    "fix": "biome check --write --unsafe .",
    "fmt": "biome format --write ."
  },
  "dependencies": {
    "@oh-my-pi/pi-wire": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:"
  },
  "devDependencies": {
    "@types/bun": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:"
  },
  "engines": {
    "bun": ">=1.3.14"
  },
  "files": [
    "src/tool-render",
    "src/env.d.ts",
    "scripts/build-tool-views.ts",
    "README.md",
    "CHANGELOG.md"
  ]
}
