	"retainedExceptions": [
		{
			"path": "packages/coding-agent/src/cli.ts",
			"reason": "Internal hidden worker re-entry dispatcher; the public ./cli export remains blocked."
		},
		{
			"path": "packages/coding-agent/src/extensibility/ui-contract.ts",
			"reason": "Structural RPC, ACP, and extension compatibility types plus a plain-text Runtime theme; it has no terminal implementation."
		},
		{
			"path": "packages/coding-agent/src/extensibility/extensions/types.ts",
			"reason": "Third-party extension compatibility retains shortcut, composer, flag, and theme signatures without shipping a local UI consumer."
		},
		{
			"path": "packages/coding-agent/src/slash-commands",
			"reason": "Runtime command routing and reserved-name compatibility used by hosts and extensions, not an interactive terminal implementation."
		},
		{
			"path": "packages/coding-agent/src/export/html",
			"reason": "Standalone HTML session export is an explicitly retained Runtime output capability."
		},
		{
			"path": "packages/collab-web",
			"reason": "Private build-time source for standalone HTML tool views; it is not a published Runtime dependency or application client."
		},
		{
			"path": "packages/browser-relay",
			"reason": "Browser-tool transport for attaching to Chrome tabs; it is a Runtime tool capability rather than an Agent application UI."
		},
		{
			"path": "packages/stats",
			"reason": "Headless session analytics and usage aggregation with no executable or dashboard."
		},
		{
			"path": "packages/utils/src/cli.ts",
			"reason": "Published argument-parsing compatibility subpath used by external or development hosts; it does not install an executable or implement a terminal UI."
		},
		{
			"path": "packages/coding-agent/src/compress",
			"reason": "Published headless compression workflow API; removing it would change functionality even though the removed end-user command registry no longer calls it."
		},
		{
			"path": "packages/coding-agent/src/commit",
			"reason": "Published commit workflow and shared Git/message utilities; external hosts may import its subpaths and Runtime code still uses its parsing helpers."
		},
		{
			"path": "packages/coding-agent/src/modes/acp/terminal-auth.ts",
			"reason": "ACP terminal-auth capability and argument contract; removing it would change the observable ACP initialize/authentication protocol."
		},
		{
			"path": "packages/coding-agent/src/config/model-resolver.ts",
			"reason": "Core Runtime model matching, routing, role, and thinking-level resolution without the removed CLI-only initial-selection output functions."
		}
	]
